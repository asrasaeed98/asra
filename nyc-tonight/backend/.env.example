# Copy to .env and fill in what you need:
#   cp .env.example .env
#
# LLM resolution: LLM_PROVIDER if set, else Groq when GROQ_API_KEY is set, else Ollama.

# --- LLM (pick one) ---
GROQ_API_KEY=
# LLM_PROVIDER=groq
# GROQ_MODEL=llama-3.3-70b-versatile

# Fully local alternative (no key): https://ollama.com → ollama pull qwen2.5:7b
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# Optional paid provider (not required for the lab):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# LLM_MAX_TOKENS=1200
# MAX_TOOL_ROUNDS=5

# --- Data tools (free; keys optional) ---
# NYC Open Data + Open-Meteo work with no keys (fixtures used if unreachable).
# NYC_OPENDATA_APP_TOKEN=
# TICKETMASTER_API_KEY=

# --- Server ---
CORS_ORIGINS=*
# LOG_LEVEL=INFO
